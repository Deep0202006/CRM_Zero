[Unit]
Description=ZeroData sealed migration executor
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/node /opt/zerodata-migration/executor.mjs %f
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/zerodata-migration /etc/zerodata-migration /srv/zerodata-migrator
