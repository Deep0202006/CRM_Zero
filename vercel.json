{
    "functions": {
        "app/api/**/*.ts": {
            "maxDuration": 10
        },
        "app/api/maintenance/selfie-retention/route.ts": {
            "maxDuration": 60
        }
    },
    "crons": [
        {
            "path": "/api/maintenance/selfie-retention",
            "schedule": "17 2 * * *"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                }
            ]
        }
    ],
    "env": {
        "NEXT_PUBLIC_SYNC_INTERVAL": "30000",
        "NEXT_PUBLIC_MAX_EXPORT_ROWS": "5000",
        "NEXT_PUBLIC_DISABLE_ANALYTICS": "true"
    },
    "build": {
        "env": {
            "NEXT_PUBLIC_SYNC_INTERVAL": "30000",
            "NEXT_PUBLIC_MAX_EXPORT_ROWS": "5000",
            "NEXT_PUBLIC_DISABLE_ANALYTICS": "true"
        }
    }
}
