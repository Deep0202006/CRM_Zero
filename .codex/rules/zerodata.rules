prefix_rule(pattern=["git","reset","--hard"],decision="forbidden",justification="Owner history is immutable.",match=[["git","reset","--hard"]],not_match=[["git","status"]])
prefix_rule(pattern=["git","clean"],decision="forbidden",justification="Unknown Owner files must survive.",match=[["git","clean","-fd"]],not_match=[["git","status"]])
prefix_rule(pattern=["git",["apply","checkout","restore"]],decision="forbidden",justification="Unscoped filesystem mutation is prohibited.",match=[["git","apply","patch.diff"],["git","checkout","--","file"],["git","restore","file"]],not_match=[["git","show","HEAD:file"]])
prefix_rule(pattern=["git","add",["-A","--all",".","-u","--update"]],decision="forbidden",justification="Broad staging can capture Owner work.",match=[["git","add","-A"],["git","add","."]],not_match=[["git","add","scripts/engineering/kernel.test.mjs"]])
prefix_rule(pattern=["git","push"],decision="prompt",justification="Publishing any branch requires approval; PreToolUse rejects unscoped targets.",match=[["git","push","origin","feature/x"]],not_match=[["git","status"]])
prefix_rule(pattern=["git","push","origin","chore/engineering-kernel-v4"],decision="prompt",justification="The reviewed feature branch may be published only with approval.",match=[["git","push","origin","chore/engineering-kernel-v4"]],not_match=[["git","push","origin","main"]])
prefix_rule(pattern=["git","push","origin","chore/engineering-kernel-v4",["--force","--force-with-lease","-f"]],decision="forbidden",justification="Force push is always prohibited.",match=[["git","push","origin","chore/engineering-kernel-v4","--force"]],not_match=[["git","push","origin","chore/engineering-kernel-v4"]])
prefix_rule(pattern=["git","push",["--force","--force-with-lease","-f"]],decision="forbidden",justification="Force push is always prohibited.",match=[["git","push","--force","origin","feature/x"]],not_match=[["git","push","origin","chore/engineering-kernel-v4"]])
prefix_rule(pattern=["git","push","origin","feature/x",["--force","--force-with-lease","-f"]],decision="forbidden",justification="Force push is always prohibited.",match=[["git","push","origin","feature/x","--force"]],not_match=[["git","push","origin","feature/x"]])
prefix_rule(pattern=["git","push","origin",["main","HEAD:main","HEAD:refs/heads/main",":main",":refs/heads/main"]],decision="forbidden",justification="Main changes require a protected PR.",match=[["git","push","origin","main"],["git","push","origin","HEAD:main"]],not_match=[["git","push","origin","chore/engineering-kernel-v4"]])
prefix_rule(pattern=[["psql","pgcli","mysql","sqlcmd"]],decision="forbidden",justification="Arbitrary database clients are prohibited.",match=[["psql"],["psql","-f","owner-fixture.sql"]],not_match=[["node","scripts/engineering/kernel-doctor.mjs"]])
prefix_rule(pattern=["supabase"],decision="forbidden",justification="Supabase commands are not an arbitrary shell capability.",match=[["supabase","db","push"],["supabase","--project-ref","X","db","push"]],not_match=[["git","status"]])
prefix_rule(pattern=["npx","supabase"],decision="forbidden",justification="Wrapped Supabase commands are prohibited.",match=[["npx","supabase","db","push"]],not_match=[["npx","jest","--version"]])
prefix_rule(pattern=["npm","exec","--","supabase"],decision="forbidden",justification="Wrapped Supabase commands are prohibited.",match=[["npm","exec","--","supabase","db","push"]],not_match=[["npm","test"]])
prefix_rule(pattern=["vercel"],decision="forbidden",justification="Deployment and environment mutation are Owner-only.",match=[["vercel","deploy"],["vercel","--prod"],["vercel","rollback"]],not_match=[["git","status"]])
prefix_rule(pattern=["npx","vercel"],decision="forbidden",justification="Wrapped Vercel mutation is prohibited.",match=[["npx","vercel","deploy"]],not_match=[["npx","jest","--version"]])
prefix_rule(pattern=["npm","exec","--","vercel"],decision="forbidden",justification="Wrapped Vercel mutation is prohibited.",match=[["npm","exec","--","vercel","deploy"]],not_match=[["npm","test"]])
prefix_rule(pattern=[["terraform","kubectl","docker","aws","az","gcloud","cloudflare"]],decision="forbidden",justification="Infrastructure mutation is outside repository scope.",match=[["terraform","apply"],["kubectl","delete","pod","fixture"],["docker","rm","fixture"]],not_match=[["git","status"]])
prefix_rule(pattern=[["node","python","python3"],["-e","--eval","-c","--input-type"]],decision="forbidden",justification="Inline interpreter code can bypass scoped edits.",match=[["node","-e","require('fs').writeFileSync('x','y')"],["python","-c","open('x','w')"]],not_match=[["node","scripts/engineering/kernel.test.mjs"]])
prefix_rule(pattern=[["tee","rm","mv","cp","sed","perl","Set-Content","Add-Content","Remove-Item","Move-Item","Copy-Item","Out-File"]],decision="forbidden",justification="Unscoped write primitives are prohibited.",match=[["tee","file"],["Set-Content","file"]],not_match=[["git","status"]])
prefix_rule(pattern=["gh","pr","merge"],decision="forbidden",justification="Codex may not merge the PR.",match=[["gh","pr","merge","89"]],not_match=[["gh","pr","view","89"]])
prefix_rule(pattern=["gh","pr",["create","view","checks"]],decision="prompt",justification="PR network operations remain user-visible.",match=[["gh","pr","view","89"],["gh","pr","checks","89"]],not_match=[["gh","repo","view"]])
