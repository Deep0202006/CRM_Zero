    {
      "id": "TASK_LIFECYCLE_ENFORCEMENT",
      "domains": [
        "engineering-control"
      ],
      "triggers": [
        "task completion",
        "unfinished work",
        "stall limit",
        "task evidence",
        "learning closeout"
      ],
      "risk": [
        "R2",
        "R3"
      ],
      "rule": "Every implementation task preserves its baseline, binds proof to its current tree and plan, closes reusable learning, and cannot stop as successful while local work remains.",
      "why": "A green OS installation is not evidence that a later engineering task is complete.",
