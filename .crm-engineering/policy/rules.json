{
  "schemaVersion": 2,
  "rules": [
    {
      "id": "G-END-001",
      "title": "No END with incomplete required acceptance",
      "severity": "CRITICAL",
      "effect": "DENY_END"
    },
    {
      "id": "G-BLOCK-001",
      "title": "Incomplete implementation is not persistent BLOCKED",
      "severity": "CRITICAL",
      "effect": "ROUTE_IMPLEMENT"
    },
    {
      "id": "G-VERIFY-001",
      "title": "Broad verification requires implementation completion",
      "severity": "HIGH",
      "effect": "DENY_BROAD_VERIFY"
    },
    {
      "id": "G-STALL-001",
      "title": "No-progress attempts escalate",
      "severity": "HIGH",
      "effect": "STALL_1_FOCUSED_RETRY__STALL_2_STRATEGY_CHANGE__STALL_3_HUMAN"
    },
    {
      "id": "G-REPO-001",
      "title": "Non-root worktrees live below .worktrees",
      "severity": "CRITICAL",
      "effect": "DENY_IMPLEMENT"
    },
    {
      "id": "G-REPO-002",
      "title": "Task base and dirty baseline must be known",
      "severity": "CRITICAL",
      "effect": "DENY_IMPLEMENT"
    },
    {
      "id": "G-MIG-001",
      "title": "Applied owner migrations are immutable",
      "severity": "CRITICAL",
      "effect": "DENY_DIFF"
    },
    {
      "id": "G-PROD-001",
      "title": "No dummy/test production business data",
      "severity": "CRITICAL",
      "effect": "DENY_ACTION"
    },
    {
      "id": "G-PROD-002",
      "title": "Production schema/data mutation requires human interrupt",
      "severity": "CRITICAL",
      "effect": "HUMAN_INTERRUPT"
    },
    {
      "id": "G-AUTH-001",
      "title": "One fact one authority many readers",
      "severity": "CRITICAL",
      "effect": "DENY_DUPLICATE_AUTHORITY"
    },
    {
      "id": "G-RELEASE-001",
      "title": "Certification belongs to exact head",
      "severity": "HIGH",
      "effect": "INVALIDATE_RELEASE_PROOF_ON_HEAD_MOVE"
    },
    {
      "id": "G-CONTEXT-001",
      "title": "Progressive disclosure only",
      "severity": "MEDIUM",
      "effect": "CONTEXT_COMPILER_ONLY"
    },
    {
      "id": "G-PROOF-001",
      "title": "Reuse fresh exact-head proof",
      "severity": "HIGH",
      "effect": "REUSE_UNCHANGED_VERIFICATION_EVIDENCE",
      "enforcement": "CONTEXT_AND_POLICY"
    },
    {
      "id": "G-LEARN-001",
      "title": "R2/R3 incident lessons become durable Graph knowledge",
      "severity": "HIGH",
      "effect": "REQUIRE_KNOWLEDGE_CLOSEOUT",
      "enforcement": "CONTEXT_AND_POLICY"
    },
    {
      "id": "G-PROD-003",
      "title": "Owner migration completion requires read-only certification before release",
      "severity": "CRITICAL",
      "effect": "REQUIRE_OWNER_POSTCHECK_EVIDENCE",
      "enforcement": "CONTEXT_AND_POLICY; Graph resume requires durable evidence IDs but does not inspect postcheck semantics"
    },
    {
      "id": "G-TOOLCHAIN-001",
      "title": "Prefer authoritative CI or an existing approved disposable toolchain",
      "severity": "HIGH",
      "effect": "REUSE_CI_OR_EXISTING_TOOLCHAIN",
      "enforcement": "CONTEXT_AND_POLICY; local external tooling download requires explicit Owner approval unless already present"
    }
  ]
}
